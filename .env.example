# =====================================================================
# BOX74 - ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com as credenciais reais da loja.
# NUNCA comite o arquivo .env preenchido no repositório Git!
# =====================================================================

# ---------------------------------------------------------------------
# 1. SERVIDOR E AMBIENTE
# ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------
# 2. SUPABASE (BANCO DE DADOS E ARMAZENAMENTO)
# Obtenha no painel do Supabase: Project Settings -> API
# ---------------------------------------------------------------------
SUPABASE_URL=https://owzamemhgbmrqmwlkqcc.supabase.co
SUPABASE_ANON_KEY=sua_chave_publica_anon_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_secreta_service_role_aqui

# ---------------------------------------------------------------------
# 3. NÚMERO OFICIAL DA BOX74 (EXCLUSIVO)
# ---------------------------------------------------------------------
BOX74_OFFICIAL_PHONE=5584981896369
BOX74_OFFICIAL_PHONE_DISPLAY=+55 84 98189-6369

# ---------------------------------------------------------------------
# 4. PROVEDOR DE WHATSAPP (Selecione: meta, evolution ou zapi)
# ---------------------------------------------------------------------
WA_PROVIDER=meta

# ---------------------------------------------------------------------
# 5. META WHATSAPP CLOUD API & EMBEDDED SIGNUP (Oficial)
# Obtenha em: https://developers.facebook.com -> Meu App -> WhatsApp
# ---------------------------------------------------------------------
# ID do Aplicativo Meta (App ID)
META_APP_ID=seu_meta_app_id_aqui

# Chave Secreta do Aplicativo Meta (App Secret) para validação HMAC-SHA256
META_WA_APP_SECRET=seu_meta_app_secret_aqui

# ID da Configuração de Embedded Signup (WhatsApp Configuration ID)
META_EMBEDDED_CONFIG_ID=seu_embedded_config_id_aqui

# Token Permanente de Acesso do Sistema Meta (System User Token)
META_WA_TOKEN=seu_meta_whatsapp_access_token_aqui

# ID da Conta do WhatsApp Business (WABA ID)
META_WA_WABA_ID=seu_waba_id_aqui

# ID do Número de Telefone Comercial (Phone Number ID)
META_WA_PHONE_NUMBER_ID=seu_phone_number_id_aqui

# Token personalizado definido por você para validação do Webhook na Meta
META_WA_VERIFY_TOKEN=defina_um_token_secreto_para_o_webhook_aqui

# Versão da Graph API da Meta (ex: v21.0)
META_WA_API_VERSION=v21.0

# Habilitar Modo de Coexistência (WhatsApp Business App + Cloud API)
META_COEXISTENCE_ENABLED=true

# ---------------------------------------------------------------------
# 5. ADAPTADORES OPCIONAIS DE WHATSAPP (Apenas se WA_PROVIDER != meta)
# ---------------------------------------------------------------------
# Evolution API (Instância auto-hospedada)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_evolution_api_key_aqui
EVOLUTION_INSTANCE=box74

# Z-API (Gateway em nuvem)
ZAPI_INSTANCE_ID=sua_instancia_zapi_aqui
ZAPI_TOKEN=seu_token_zapi_aqui
ZAPI_CLIENT_TOKEN=seu_client_token_zapi_opcional_aqui

# ---------------------------------------------------------------------
# 6. PROVEDOR DE INTELIGÊNCIA ARTIFICIAL CONTEXTUAL (Opcional)
# O agente funciona perfeitamente sem IA por regras e NLU local determinístico.
# Preencha se desejar ativar respostas conversacionais dinâmicas.
# ---------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=groq
# AI_PROVIDER opções: 'groq', 'openai', 'openrouter'
AI_API_KEY=sua_chave_de_api_de_ia_aqui
# Modelos sugeridos:
# Groq: llama-3.3-70b-versatile
# OpenAI: gpt-4o-mini
# OpenRouter: meta-llama/llama-3.3-70b-instruct
AI_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------
# 7. ATENDIMENTO HUMANO E NOTIFICAÇÃO DO ADMINISTRADOR
# Número que receberá alertas quando um cliente solicitar transbordo humano
# ---------------------------------------------------------------------
NOTIFICATION_ADMIN_PHONE=5585999999999
ALERT_ON_HANDOFF=true

# ---------------------------------------------------------------------
# 8. DADOS COMERCIAIS BOX74 (PAGAMENTOS PIX)
# ---------------------------------------------------------------------
BOX74_PIX_KEY=5fbf536f-8dea-4ff2-9546-7f4e0e487e3d
BOX74_PIX_OWNER=Adriana Maria de Lima Almeida
